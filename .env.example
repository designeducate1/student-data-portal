# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Google Classroom bridge (pilot) ---
# From a Google Cloud Console project (console.cloud.google.com):
#   1. Enable the "Google Classroom API".
#   2. Configure the OAuth consent screen as "External" + "Testing",
#      and add the connecting teacher's Google account as a test user.
#   3. Create an OAuth 2.0 Client ID (type: Web application), with
#      redirect URI: <your deployed URL>/.netlify/functions/classroom-auth-callback
#      (and http://localhost:4300/.netlify/functions/classroom-auth-callback for local dev).
# NOTE: while the consent screen is in "Testing" status, Google expires
# the refresh token after 7 days -- reconnecting (re-running the consent
# flow) resets that clock. See classroom-status.js / ClassroomReconnectBanner.
GOOGLE_CLASSROOM_CLIENT_ID="MY_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_CLASSROOM_CLIENT_SECRET="MY_GOOGLE_OAUTH_CLIENT_SECRET"
